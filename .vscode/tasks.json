{
    // Ctrl+Shift+B 默认执行 "cmake: build"，它会先执行 "cmake: configure"
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                // 本机没有安装 Visual Studio，CMake 的默认生成器会落到 NMake，
                // 因找不到 nmake/cl.exe 而配置失败，必须显式指定 MinGW
                "-G", "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug",
                // PATH 里 C:/MinGW-w64 排在前面，那是 GCC 8.1，其 <filesystem> 在 Windows 下无法编译。
                // 显式指定 winget 安装的 WinLibs GCC 16，保证清空 build/ 后仍用新工具链。
                "-DCMAKE_CXX_COMPILER=C:/Users/ty1l/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/g++.exe"
            ],
            "problemMatcher": []
        },
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build",
                "--config", "Debug"
            ],
            "dependsOn": "cmake: configure",
            // dependsOrder 默认是 parallel，会和 configure 抢同一个 build 目录
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // 同时挂 MSVC 和 GCC 的错误匹配器，实际命中的那个才会解析出 Problems 面板条目
            "problemMatcher": ["$msCompile", "$gcc"]
        },
        {
            "label": "run: SoftRasterizer",
            "type": "shell",
            "command": "${workspaceFolder}/build/bin/SoftRasterizer.exe",
            "options": {
                // 工作目录就是仓库根目录，framebuffer.tga 会输出到这里
                "cwd": "${workspaceFolder}/out"
            },
            "dependsOn": "cmake: build",
            "problemMatcher": []
        }
    ]
}
