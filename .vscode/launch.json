{
    "version": "0.2.0",
    "configurations": [
        {
            // 本机实际使用 MinGW，放在第一位，F5 默认选中它
            "name": "SoftRasterizer (MinGW + gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/SoftRasterizer.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            // 必须用与 GCC 16 配套的 GDB：PATH 里的 C:/MinGW-w64 是 GDB 8.1，
            // 读不懂 GCC 16 的 DWARF 5 调试信息，会断点失效 / 调试会话卡住。
            "miDebuggerPath": "C:/Users/ty1l/AppData/Local/Microsoft/WinGet/Packages/BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用美观打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build"
        }
    ]
}
